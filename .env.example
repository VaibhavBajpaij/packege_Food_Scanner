# Food Intelligence Engine - Environment Variables Template
# Copy this file to .env and fill in your keys if utilizing external services.
# Core system operates offline using local datasets and local OCR.

# 1. Google Gemini AI API Key (Optional: for AI Clinical Nutritionist)
# Register at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. USDA FoodData Central API Key (Optional: for live nutrition verification)
# Register at: https://api.data.gov/signup/ or https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your_usda_api_key_here
FDC_API_KEY=your_usda_api_key_here

# 3. Open Food Facts User Agent identifier (Optional: for polite REST lookups)
OFF_USER_AGENT=PackagedFoodScanner - WebWorkbench - Version 1.0 - (contact: engineering@example.com)

# 4. Engine Execution Mode: local_only / hybrid
ENGINE_MODE=hybrid

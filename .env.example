# Food Intelligence Engine - Environment Variables Template
# Copy this file to .env and fill in your keys if utilizing optional external services.
# NOTE: The core system operates entirely offline using local datasets and local OCR.
# Do NOT commit .env containing real keys to version control.

# USDA FoodData Central API Key (Optional: for live search validation)
# Register at: https://api.data.gov/signup/
FDC_API_KEY=your_usda_api_key_here

# Open Food Facts User Agent identifier (Optional: for polite REST lookups)
OFF_USER_AGENT=FoodIntelligenceEngine/1.0 (research-prototype)

# Engine Execution Mode: local_only / hybrid
ENGINE_MODE=local_only

      "inequalities": "Bounded declarations such as '<1 g' or '<0.1 g' tracked with comparator semantics.",
      "unresolved_fields": "Fields that cannot be independently confirmed from the photograph."
    },
    "split_warning": "All 22 samples are classified as development samples. No sample is treated as an independent holdout."
  },
